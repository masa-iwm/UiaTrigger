<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UiaTrigger.Tests</RootNamespace>
    <AssemblyName>UiaTrigger.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- ja-JP のサテライトを解決する必要があるため無効にしないこと (docs/LOCALIZATION.md §2) -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!--
      FakeTimeProvider。TimeProvider 化 (docs/DESIGN.md C10 / B8) の効果はこれが無いと
      確かめられない — デバウンスもレート制限も「実時間を待つ」テストでしか触れない。
    -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!--
      UiaTrigger.Picker.WinUI の公開面を、参照せずにメタデータで読む
      (PublicApiDocumentationTests)。参照すると x64 と Windows App SDK が
      この AnyCPU のプロジェクトに乗り移り、T1 が「UIA にも GUI にも依らない層」で
      なくなる (docs/TESTING.md §1)。
    -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UiaTrigger.Core\UiaTrigger.Core.csproj" />
    <!--
      ピッカーの UI 非依存部分 (docs/TESTING.md §1 T1 / docs/DESIGN.md §12)。

      UiaTrigger.Picker.Core は net10.0-windows / AnyCPU なので、WinUI3 / x64 の View と違い
      普通のプロジェクト参照でテストできる。TriggerPickerPresenter もここに載る。
    -->
    <ProjectReference Include="..\..\src\UiaTrigger.Picker.Core\UiaTrigger.Picker.Core.csproj" />
    <!--
      WPF / WinForms の View (docs/DESIGN.md §12)。

      「View は T1 から触れない」は WinUI3 / x64 / WindowsAppSDK の制約であって
      View 一般の話ではない。この 2 つは
      net10.0-windows / AnyCPU なので普通に参照でき、フレームワーク参照
      (WindowsDesktop.App.WPF / .WindowsForms) も推移的に流れてくる —
      このテストプロジェクトに UseWPF / UseWindowsForms を足す必要は無い。

      これで docs/MANUAL-CHECKS.md §4.3 相当の項目のうち、可視のデスクトップを要さないものが
      自動テストに載る。コンテナの実体化を伴う経路だけが手動 / T4 に残る。
    -->
    <ProjectReference Include="..\..\src\UiaTrigger.Picker.Wpf\UiaTrigger.Picker.Wpf.csproj" />
    <ProjectReference Include="..\..\src\UiaTrigger.Picker.WinForms\UiaTrigger.Picker.WinForms.csproj" />
    <!--
      サンプルホスト 3 つが共有するコマンドライン解析 (docs/DESIGN.md §12)。

      解析そのもの (HostCommandLine.Parse) は状態を持たない純関数なので T1 に載る。
      ホストの実行ファイルは 3 つとも T1 から参照できない (WinUI3 は x64、
      WPF / WinForms は WinExe) が、**解析はホストの外に出してあるので触れる**。
    -->
    <ProjectReference Include="..\..\src\UiaTrigger.App.Shared\UiaTrigger.App.Shared.csproj" />
  </ItemGroup>

</Project>
