<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T5: 合成入力で<b>最下層から</b>駆動するテスト (docs/TESTING.md §1 の T5 / §3)。

    ここでしか見られないもの: 低レベルキーボードフック (WH_KEYBOARD_LL) と、
    実マウス入力だけが通る WM_NCHITTEST。UIA のコントロールパターンは Invoke / Select を
    要素へ直接届けるので、どちらも<b>一度も通らない</b> — T4 がここへ来られない理由である。

    <b>T4 と別プロジェクトにしてあるのは政策の都合である</b> (docs/TESTING.md §3):
      (a) CI の lint (2) が「このディレクトリだけ」で切れる
      (b) 実機の入力を奪うので、どのテストとも並走させられない
      (c) 解禁の条件がソースの配置として読み取れる

    <b>ローカルで T3 / T4 と同時に走らせないこと。</b>直列実行の指定 (AssemblyInfo.cs) は
    アセンブリ単位なので、別プロセスまでは止められない。ここは画面のウィンドウだけでなく
    <b>キーボードとマウスそのもの</b>を奪うので、重なると相手の操作を横取りする。
    CI でも picker-ui と<b>同じランナーに載せない</b>。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UiaTrigger.Input.Tests</RootNamespace>
    <AssemblyName>UiaTrigger.Input.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      XAML は 1 行も無いのに UseWPF を立てているのは、UIA <b>クライアント</b>
      (System.Windows.Automation) を引くためである。T4 と同じ理由・同じ形なので揃える —
      リンク共有しているハーネス (PickerHostProcess / Ui) がこれを前提にしている。
    -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF を立てると暗黙の using から System.IO が外れる (T4 の csproj を参照) -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <!-- テストプロセスを PerMonitorV2 にするため (DpiAwareness)。T4 と同じ -->
    <ProjectReference Include="..\..\src\UiaTrigger.Core\UiaTrigger.Core.csproj" />
    <!-- OverlayGeometry (純関数) から期待矩形を計算するため。マジックナンバーを書かない -->
    <ProjectReference Include="..\..\src\UiaTrigger.Picker.Core\UiaTrigger.Picker.Core.csproj" />
    <!-- 対象アプリは「テスト中に起動する実行ファイル」として要る -->
    <ProjectReference Include="..\UiaTrigger.TestTarget\UiaTrigger.TestTarget.csproj"
                      ReferenceOutputAssembly="false" />
    <!--
      サンプルホストへの ProjectReference は張らない (T4 の csproj に理由がある)。
      → ソリューション全体をビルドしてから走らせること。
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
      ハーネスは T1 / T3 / T4 のものをそのまま使う (二重定義にしない)。
      <b>ここに写しを作らないこと</b> — 写すと、片方だけが直された状態が生まれ、
      「T4 では通るのに T5 では通らない」の原因がハーネスの差になる。
    -->
    <Compile Include="..\UiaTrigger.Core.Tests\RepoPaths.cs" Link="RepoPaths.cs" />
    <Compile Include="..\UiaTrigger.RealUia.Tests\TargetProfile.cs" Link="TargetProfile.cs" />
    <Compile Include="..\UiaTrigger.RealUia.Tests\TestTargetProcess.cs" Link="TestTargetProcess.cs" />
    <Compile Include="..\UiaTrigger.Picker.UiTests\Ui.cs" Link="Ui.cs" />
    <Compile Include="..\UiaTrigger.Picker.UiTests\NativeWindows.cs" Link="NativeWindows.cs" />
    <Compile Include="..\UiaTrigger.Picker.UiTests\DesktopLayout.cs" Link="DesktopLayout.cs" />
    <Compile Include="..\UiaTrigger.Picker.UiTests\PickerHostProfile.cs" Link="PickerHostProfile.cs" />
    <Compile Include="..\UiaTrigger.Picker.UiTests\PickerHostProcess.cs" Link="PickerHostProcess.cs" />
    <Compile Include="..\UiaTrigger.Picker.UiTests\OverlayScenario.cs" Link="OverlayScenario.cs" />
  </ItemGroup>

</Project>
