<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Platform / PlatformTarget

    PlatformTarget はここで強制しない。Core は純 IL なので AnyCPU として発行し、
    x64 固定でしか読み込めないアセンブリにしないため (docs/DESIGN.md D5)。
    x64 が必要なのは WinUI 3 の**アプリ** (App.WinUI) だけである。UiaTrigger.slnx で
    Platform=x64 に固定しており、SDK が Platform から PlatformTarget を導出する。

    **Picker.WinUI は固定しない。**WinUI 3 のライブラリにアーキテクチャの要求は無く
    (実測: Microsoft.WinUI.dll も CommunityToolkit の Sizers も MSIL)、slnx で固定すると
    ソリューション pack がそれを拾って**x64 の dll を lib/ に配る**ことになる (D4/D5)。
  -->
  <PropertyGroup>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <!--
    ローカライズ (docs/LOCALIZATION.md §1)
    en-US をプライマリ (neutral) とし、ja はサテライトアセンブリで供給する。
    InvariantGlobalization=true にするとサテライトが一切使えなくなる
    (docs/LOCALIZATION.md §2 で実測確認済み) ため、
    個々のプロジェクトで有効化しないこと。
  -->
  <PropertyGroup>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    WinUI 3 の pin (WindowsSdkPackageVersion / CsWinRTAotWarningLevel) は**ここに置けない**。

    props は csproj 本体より先に評価されるので、`UseWinUI` を条件にしても常に偽になる
    (Directory.Build.targets の README pack と同じ罠 — あちらは IsPackable で踏んだ)。
    条件を外して全プロジェクトに掛けると、WinUI を使わない側にも Windows SDK 投影の
    版が入る。targets へ移すのも駄目で、restore の段には間に合わない。

    そこで pin は 2 つの csproj (Picker.WinUI / App.WinUI) に残し、**ずれないことを
    テストで縛る** (WinUiPinTests)。守りたいのは「片方だけ更新して AOT 破壊の検出が
    黙って外れる」ことなので、場所の一元化ではなく値の一致が本体である。
  -->

  <!-- 警告はエラーとして扱う (docs/DESIGN.md D3) -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- 再現可能ビルド / シンボル (NuGet 配布向け, docs/DESIGN.md D4) -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- 既定では発行しない。パッケージ化するプロジェクトが個別に true にする -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    パッケージの共通メタデータ (docs/DESIGN.md D4 / docs/RELEASING.md §1)

    版数は 0.1.0-preview.1 から始める。0.x のあいだ公開 API は安定化前で、
    破壊的に変わりうる (README / CHANGELOG がそう告知している)。1.0.0 で出すと
    「安定している」という約束になるので出さない。プレリリース札を付けてあるので、
    利用者が明示的に選ばない限り復元されない。

    Description と PackageTags は**プロジェクトごと**に書く (中身が違うため)。
  -->
  <PropertyGroup>
    <Version>0.1.0-preview.7</Version>
    <Authors>masa-iwm</Authors>
    <Product>UiaTrigger</Product>
    <Copyright>Copyright (c) 2026 masa-iwm</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      nuget.org の Release Notes 欄。**空のまま出すとその版は永久に空である** —
      公開済みの版の表示は後から直せない。中身を写さずリンクにするのは、
      CHANGELOG が正でありここに写しを作るとずれるためである。
    -->
    <PackageReleaseNotes>See the changelog for what changed in this version: https://github.com/masa-iwm/UiaTrigger/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/masa-iwm/UiaTrigger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/masa-iwm/UiaTrigger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
