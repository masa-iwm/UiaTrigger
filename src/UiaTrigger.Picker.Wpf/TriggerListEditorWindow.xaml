<!--
    ユーザー向け文字列はここに書かない (docs/DESIGN.md L3)。
    WPF には x:Uid の実行時解決が無いので、ラベルはコードビハインドが
    EditorStringKeys 経由で代入する。XamlLocalizationTests がここへの直書きを検出して失敗する。
-->
<Window
    x:Class="UiaTrigger.Picker.Wpf.TriggerListEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900" Height="560"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 一覧に対する操作 -->
        <WrapPanel Margin="0,0,0,8">
            <Button x:Name="AddTriggerButton" Padding="10,3" Margin="0,0,8,0" Click="OnAdd" />
            <Button x:Name="EditTriggerButton" Padding="10,3" Margin="0,0,8,0" Click="OnEdit" />
            <Button x:Name="DeleteTriggerButton" Padding="10,3" Margin="0,0,8,0" Click="OnDelete" />
        </WrapPanel>

        <!--
            トリガー一覧。複数選択にするのは「まとめる」と「まとめて削除」のためである。
            AutomationProperties.Name はコードビハインドが代入する — 見出しを持たないので、
            入れないとスクリーンリーダーには名前の無い一覧として出る。
        -->
        <ListBox x:Name="EditorTriggerList" Grid.Row="1" SelectionMode="Extended"
                 HorizontalContentAlignment="Left"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 MouseDoubleClick="OnRowDoubleClick" />

        <!-- まとめる / ほどく -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <WrapPanel Margin="0,0,0,4">
                <TextBlock x:Name="ExpressionBoxLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ExpressionBox" Width="260" Margin="0,0,8,0" />
                <TextBlock x:Name="UnwatchedBoxLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="UnwatchedBox" Width="200" Margin="0,0,8,0" />
                <TextBlock x:Name="CombinePollIntervalBoxLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="CombinePollIntervalBox" Width="100" />
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="CombineTriggersButton" Padding="10,3" Margin="0,0,8,0" Click="OnCombine" />
                <Button x:Name="DecomposeTriggerButton" Padding="10,3" Click="OnDecompose" />
            </WrapPanel>
        </StackPanel>

        <TextBlock x:Name="EditorStatus" Grid.Row="3" Margin="0,8,0,0" Opacity="0.8"
                   TextWrapping="Wrap" />

        <!-- 確定 / 取り消し -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="AcceptButton" IsDefault="True" MinWidth="88" Padding="10,3"
                    Margin="0,0,8,0" Click="OnAccept" />
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Padding="10,3"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
