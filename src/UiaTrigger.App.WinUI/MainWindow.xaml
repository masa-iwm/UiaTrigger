<!--
    ユーザー向け文字列は Strings\<culture>\Resources.resw から x:Uid で解決する
    (docs/DESIGN.md L3)。Window.Title だけは x:Uid が効かないのでコードで設定している。
-->
<Window
    x:Class="UiaTrigger.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Grid Padding="12" RowSpacing="8">
        <!--
            トリガー一覧とログ一覧の高さの配分はユーザーが動かせる (下の GridSplitter)。
            ログ一覧 (D9) と分け合うため、トリガー一覧は既定で約半分の高さになる。
            docs/MANUAL-CHECKS.md §9 の「高さの配分が実用的であること」は、<b>配分を
            固定したまま「実用的な値」を探すのではなく、動かせること</b>で満たす。
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenPickerButton" x:Uid="OpenPickerButton" Click="OnOpenPicker" />
            <!--
                A18 (ピッカーの複数起動) を実機で確かめるための口 (docs/MANUAL-CHECKS.md §6)。
                OverlayController は static singleton ではなく登録表方式である — その効果は
                ホストが 2 つ目を開けなければ実機で確かめようがない。
            -->
            <Button x:Name="OpenAnotherPickerButton" x:Uid="OpenAnotherPickerButton"
                    Click="OnOpenAnotherPicker" />
            <Button x:Name="DeleteButton" x:Uid="DeleteButton" Click="OnDelete" />
            <Button x:Name="ReloadButton" x:Uid="ReloadButton" Click="OnReload" />
            <!--
                トリガ一覧エディタ (docs/DESIGN.md §4)。この窓が持っている一覧・削除・
                まとめる相当を、<b>組み込む側が使える形で</b>ライブラリが持つ。
                ホスト側は「渡して受け取る」だけである。
            -->
            <Button x:Name="EditListButton" x:Uid="EditListButton" Click="OnEditList" />
            <!--
                D9 (ピッカー → 監視の E2E)。3 ホストのうちここだけが持つ
                (README の "Two asymmetries are deliberate" / docs/DESIGN.md §12)。

                トグル 1 つにしないのは、x:Uid が与える Content が静的だからである。
                2 つ並べて IsEnabled で状態を表すと、状態が UIA から外に見える。
            -->
            <Button x:Name="StartMonitorButton" x:Uid="StartMonitorButton" Click="OnStartMonitor" />
            <Button x:Name="StopMonitorButton" x:Uid="StopMonitorButton" Click="OnStopMonitor"
                    IsEnabled="False" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <!--
            トリガー一覧の行は「id / 表示名 / プロセス名 / 種別 / 条件」を 1 行に並べるので
            すぐ横に長くなる。水平スクロールできないと右側が読めない。

            素の ListView なので添付プロパティがそのまま効く (自分に付いた ScrollViewer.* を
            テンプレート内の ScrollViewer へ TemplateBinding で流す)。あわせて行を左寄せに
            しないと、内容がビューポート幅いっぱいに引き伸ばされてはみ出しが起きず、
            スクロールバーも出ない。
        -->
        <!--
            複合条件 (docs/DESIGN.md §4)。録ったトリガーを選んで 1 件にまとめる。
            条件の名前には元のトリガーの id をそのまま使うので、式が読める形になる。

            まとめた結果も同じ一覧に並ぶので、それをまた選んでまとめれば入れ子になる。
            そのための UI は要らない — 入れ子は式の中ではなく「まとめ直し」で得られる。
        -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CombineButton" x:Uid="CombineButton" Click="OnCombine" />
            <TextBlock x:Name="ExpressionLabel" x:Uid="ExpressionLabel" VerticalAlignment="Center" />
            <TextBox x:Name="ExpressionText" MinWidth="220" VerticalAlignment="Center" />
            <TextBlock x:Name="UnwatchedLabel" x:Uid="UnwatchedLabel" VerticalAlignment="Center" />
            <TextBox x:Name="UnwatchedText" MinWidth="140" VerticalAlignment="Center" />
        </StackPanel>

        <ListView x:Name="TriggerList" Grid.Row="2" SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.IsHorizontalRailEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!--
            2 つの一覧の境界。ResizeDirection / ResizeBehavior は明示する —
            既定の推測が外れても例外にならず、動かないだけだからである
            (Picker.WinUI の同じ箇所に理由を書いた)。
        -->
        <controls:GridSplitter x:Name="ListSplitter" x:Uid="ListSplitter" Grid.Row="3"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!--
            監視のログ。発火 / 解決状態の変化 / 拾い所の無い例外を 1 つの一覧へ時刻付きで出す。
            行の書式はリソース (MonitorRow*) に置いてあり、ここにも code-behind にも
            表示文字列は書かない。
        -->
        <ListView x:Name="MonitorLogList" Grid.Row="4" SelectionMode="None"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.IsHorizontalRailEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock x:Name="FilePathText" Grid.Row="5" Opacity="0.7" FontSize="12" />
    </Grid>
</Window>
