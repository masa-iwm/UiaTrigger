<?xml version="1.0" encoding="utf-8"?>
<!--
  UiaTrigger.App (サンプルホスト) のユーザー向け文字列 (プライマリ = en-US)。
  日本語は ..\ja-jp\Resources.resw で供給する。

  App は「ライブラリの使い方の見本」でもあるので、ここもライブラリ本体と同じ規律で書く
  (docs/LOCALIZATION.md §3)。
-->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="WindowTitle" xml:space="preserve">
    <value>UiaTrigger sample host</value>
  </data>
  <data name="OpenPickerButton.Content" xml:space="preserve">
    <value>Add with the picker</value>
  </data>
  <data name="OpenAnotherPickerButton.Content" xml:space="preserve">
    <value>Open a second picker</value>
  </data>
  <data name="DeleteButton.Content" xml:space="preserve">
    <value>Delete</value>
  </data>
  <data name="ReloadButton.Content" xml:space="preserve">
    <value>Reload</value>
  </data>
  <data name="EditListButton.Content" xml:space="preserve">
    <value>Edit the list…</value>
  </data>
  <data name="StartMonitorButton.Content" xml:space="preserve">
    <value>Start monitoring</value>
  </data>
  <data name="StopMonitorButton.Content" xml:space="preserve">
    <value>Stop monitoring</value>
  </data>
  <data name="CombineButton.Content" xml:space="preserve">
    <value>Combine the selected</value>
  </data>
  <data name="ListSplitter.AutomationProperties.Name" xml:space="preserve">
    <value>Resize the trigger list</value>
  </data>
  <data name="ExpressionLabel.Text" xml:space="preserve">
    <value>Expression (&amp;&amp;, ||, !, parentheses; blank = require all):</value>
  </data>
  <data name="UnwatchedLabel.Text" xml:space="preserve">
    <value>Only narrow, never fire (names, comma separated):</value>
  </data>

  <data name="TriggerCount" xml:space="preserve">
    <value>{0} trigger(s)</value>
    <comment>{0} = number of triggers</comment>
  </data>
  <data name="TriggerCountSaved" xml:space="preserve">
    <value>{0} trigger(s), saved</value>
    <comment>{0} = number of triggers</comment>
  </data>
  <data name="LoadFailed" xml:space="preserve">
    <value>Could not read the trigger file: {0}</value>
    <comment>{0} = exception message</comment>
  </data>
  <data name="SaveFailed" xml:space="preserve">
    <value>Could not write the trigger file: {0}</value>
    <comment>{0} = exception message</comment>
  </data>
  <data name="NoClauses" xml:space="preserve">
    <value>(no condition)</value>
  </data>
  <data name="TriggerRow" xml:space="preserve">
    <value>[{0}] {1} — {2} / {3} : {4}</value>
    <comment>{0} = id, {1} = display name, {2} = process name, {3} = TriggerOn, {4} = clauses</comment>
  </data>
  <data name="CompositeRow" xml:space="preserve">
    <value>[{0}] {1} condition(s) / {2} : {3}</value>
    <comment>{0} = id, {1} = number of clauses, {2} = TriggerOn, {3} = expression</comment>
  </data>
  <data name="CombineFailed" xml:space="preserve">
    <value>Could not combine: {0}</value>
    <comment>{0} = reason</comment>
  </data>
  <data name="CombineDone" xml:space="preserve">
    <value>Created '{0}' from {1} trigger(s).</value>
    <comment>{0} = new trigger id, {1} = number of source triggers</comment>
  </data>

  <data name="MonitorStarted" xml:space="preserve">
    <value>Monitoring {0} trigger(s) over {1} element(s)</value>
    <comment>{0} = number of triggers, {1} = number of distinct elements (ElementSlotCount)</comment>
  </data>
  <data name="MonitorStopped" xml:space="preserve">
    <value>Monitoring stopped</value>
  </data>
  <data name="MonitorStartFailed" xml:space="preserve">
    <value>Could not start monitoring: {0}</value>
    <comment>{0} = exception message</comment>
  </data>
  <data name="MonitorRowFired" xml:space="preserve">
    <value>{0:T}  FIRED  [{1}] {2} : '{3}' → '{4}'</value>
    <comment>{0} = timestamp, {1} = trigger id, {2} = TriggerOn, {3} = old value, {4} = new value</comment>
  </data>
  <data name="MonitorRowResolved" xml:space="preserve">
    <value>{0:T}  resolved  [{1}] : {2}</value>
    <comment>{0} = timestamp, {1} = trigger id, {2} = reason</comment>
  </data>
  <data name="MonitorRowUnresolved" xml:space="preserve">
    <value>{0:T}  UNRESOLVED  [{1}] : {2}</value>
    <comment>{0} = timestamp, {1} = trigger id, {2} = reason</comment>
  </data>
  <data name="MonitorRowError" xml:space="preserve">
    <value>{0:T}  ERROR  {1}</value>
    <comment>{0} = timestamp, {1} = exception message</comment>
  </data>
</root>
