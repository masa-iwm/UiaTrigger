<Project Sdk="Microsoft.NET.Sdk">

  <!--
    サンプルホスト — WinUI 3 版 (docs/DESIGN.md §12)。

    View が 3 変種あるので、ホストも 3 つある。
    ただし D9 (ピッカー → 監視の E2E ショーケース) は**この WinUI 版だけ**に置く。
    3 重化しても得るものが無く、README にその非対称を書いてある。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>UiaTrigger.App.WinUI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishAot>true</PublishAot>
    <!-- DPI 認識 (PerMonitorV2) を宣言する。未宣言だと座標が仮想化されホイールが効かない -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Picker.WinUI と同じ理由で明示する (docs/DESIGN.md §12)。
      **このホストは自分でも GridSplitter を使う** (2 つの一覧の間の ListSplitter) ので、
      A23 の不具合はここにも掛かる。
    -->
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>
  </PropertyGroup>

  <!--
    RuntimeIdentifier は Platform から導く (docs/DESIGN.md D5 / docs/RELEASING.md §5)。

    WinUI3 + WindowsAppSDKSelfContained + PublishAot はビルド時に RID が決まっている必要がある。
    win-x64 を**ハードコード**すると、-p:Platform=ARM64 を渡しても x64 のまま建ち、
    ARM64 へは発行できない。

    既定は win-x64 である (UiaTrigger.slnx がこのプロジェクトを x64 に固定しているので、
    ソリューションからのビルドは何も変わらない)。呼び出し元が -r で明示した場合はそちらを優先する。

    ライブラリ側 (Core / Picker.*) は AnyCPU で出るので、この件は**配布物には掛からない** —
    サンプルホストを ARM64 機で発行できるかどうかの話である (docs/RELEASING.md §1)。
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- 一覧の高さをユーザーが変えられるようにする (Picker.WinUI 経由でも来るが、直に使う) -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiaTrigger.App.Shared\UiaTrigger.App.Shared.csproj" />
    <ProjectReference Include="..\UiaTrigger.Core\UiaTrigger.Core.csproj" />
    <ProjectReference Include="..\UiaTrigger.Picker.WinUI\UiaTrigger.Picker.WinUI.csproj" />
  </ItemGroup>

</Project>
