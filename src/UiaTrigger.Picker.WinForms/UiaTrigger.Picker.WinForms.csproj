<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ピッカーの Windows Forms View (docs/DESIGN.md §12)。

    振る舞いは UiaTrigger.Picker.Core の TriggerPickerPresenter が持つ。ここに残るのは
    「Windows Forms の事実」だけで、他の 2 変種と最も違うのは**データバインディングが
    無い**ことである。TreeView はモデルを見てくれないので、ObservableCollection と
    TreeNodeCollection を手で同期させる層 (TreeMirror) が要る。それが 3 変種のうち
    ここにしか無いコードであり、いちばん壊れやすいので独立したクラスに切ってある。

    デザイナー (.Designer.cs) は使わない。デザイナーが吐く Text = "…" のリテラルを
    ハードコード検出の対象外にしなければならなくなるためである。

    IsAotCompatible は付けない (Windows Forms は Native AOT 非対応)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UiaTrigger.Picker.WinForms</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet 配布 (docs/DESIGN.md D4 / docs/RELEASING.md §1)。共通のメタデータは Directory.Build.props -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The Windows Forms view for the UiaTrigger element picker (TriggerPickerForm). Holds no behaviour of its own - all of it lives in UiaTrigger.Picker.Core. Note that this variant confirms the selected row with a single button rather than a button inside each row, because the Windows Forms TreeView cannot host arbitrary controls in a row.</Description>
    <PackageTags>uiautomation;uia;automation;windows;picker;winforms</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiaTrigger.Picker.Core\UiaTrigger.Picker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UiaTrigger.Core.Tests" />
  </ItemGroup>

  <!--
    IntelliSense の日本語化 (docs/LOCALIZATION.md §4)。公開面はウィンドウ 1 つぶんしかないが、
    ロールアップの単位はファイルなので過不足なく覆う必要がある。
    対象から漏れていないことは PublicApiDocumentationTests が見ている。
  -->
  <ItemGroup>
    <None Include="Resources\UiaTrigger.Picker.WinForms.ja.xml"
          Link="ja\UiaTrigger.Picker.WinForms.xml"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="ja\UiaTrigger.Picker.WinForms.xml" />
  </ItemGroup>

</Project>
