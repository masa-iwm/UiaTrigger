root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx,xaml,resx,resw,manifest,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---- using ----
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ---- namespace / brace ----
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning

# ---- var / expression ----
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# ---- modern syntax ----
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = false:silent
dotnet_style_prefer_conditional_expression_over_return = false:silent

# ---- naming: private fields are _camelCase ----
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ---- naming: constants are PascalCase ----
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# ---- 文字列比較・書式 (docs/LOCALIZATION.md §3) ----
# 比較・永続化に使う文字列は必ず Invariant/Ordinal。
# 明示しない ToString()/Compare() を警告として検出する。
dotnet_diagnostic.CA1307.severity = warning   # StringComparison を指定する
dotnet_diagnostic.CA1310.severity = warning   # 文化非依存の StringComparison を指定する
dotnet_diagnostic.CA1305.severity = warning   # IFormatProvider を指定する
dotnet_diagnostic.CA1304.severity = warning   # CultureInfo を指定する

# ---- 抑制 (根拠付き) ----
# CA1848: LoggerMessage デリゲートの使用。ライブラリのログは [LoggerMessage] 生成に
# 揃えてある (Core の Diagnostics/Log.cs) が、テスト・ホスト側の素朴な ILogger 呼び出し
# にまで強制はしない。
dotnet_diagnostic.CA1848.severity = none

[src/UiaTrigger.Core/Interop/*.cs]
# COM interop は UIAutomationClient.h の vtable 順・命名をそのまま写す必要があるため、
# get_Xxx / put_Xxx といった命名規約違反を許容する。
dotnet_diagnostic.CA1707.severity = none      # 識別子にアンダースコアを含めない
dotnet_diagnostic.IDE1006.severity = none     # 命名規則

[tests/**/*.cs]
# テストでは意図的に到達不能・未使用のコードを書くことがある
dotnet_diagnostic.CA1707.severity = none      # テストメソッド名の Method_Condition_Expectation を許容
dotnet_diagnostic.CA1861.severity = none      # 定数配列の引数
